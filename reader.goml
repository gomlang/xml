package xml;

use std::utf8;

struct RawAttribute {
    name: string,
    value: string,
}

enum RawToken {
    Start(string, bool),
    End(string),
    Text(string),
    Comment(string),
    CData(string),
    Instruction(string, string),
}

struct ReaderState {
    pending: Vec[u8],
    offset: isize,
    received: isize,
    declaration_offset: isize,
    decoded: isize,
    tokens: isize,
    open: Vec[QName],
    scopes: Vec[Vec[Namespace]],
    root_seen: bool,
    root_done: bool,
    ended: bool,
    failed: bool,
}

pub struct Reader {
    limits: Limits,
    state: Ref[ReaderState],
}

fn initial_reader_state() -> ReaderState {
    ReaderState {
        pending: Vec::new(),
        offset: 0,
        received: 0,
        declaration_offset: 0,
        decoded: 0,
        tokens: 0,
        open: Vec::new(),
        scopes: Vec::new(),
        root_seen: false,
        root_done: false,
        ended: false,
        failed: false,
    }
}

fn space(value: u8) -> bool {
    value == 32 || value == 9 || value == 10 || value == 13
}

fn slice_text(data: Vec[u8], start: isize, end: isize, offset: isize) -> Result[string, Error] {
    utf8::decode_slice(data.as_slice().sub(start, end)).map_err(
        |problem| error(ErrorKind::Utf8, offset + start + problem.valid_up_to(), "invalid UTF-8"),
    )
}

fn begins(data: Vec[u8], at: isize, pattern: string) -> bool {
    if pattern.byte_len() > data.len() - at {
        return false
    }
    for index in 0..pattern.byte_len() {
        if data[at + index] != pattern.byte_get(index) {
            return false
        }
    }
    true
}

fn find_pattern(data: Vec[u8], start: isize, pattern: string) -> Option[isize] {
    let mut at = start;
    while at + pattern.byte_len() <= data.len() {
        if begins(data, at, pattern) {
            return Option::Some(at)
        }
        at += 1;
    }
    Option::None
}

fn tag_end(data: Vec[u8], start: isize) -> Option[isize] {
    let mut quote: u8 = 0;
    for at in start..data.len() {
        let value = data[at];
        if quote == 0 {
            if value == 34 || value == 39 {
                quote = value;
            } else if value == 62 {
                return Option::Some(at)
            }
        } else if value == quote {
            quote = 0;
        }
    }
    Option::None
}

fn next_raw(data: Vec[u8], at: isize, offset: isize, limits: Limits, final_input: bool) -> Result[
    Option[(RawToken, isize)],
    Error,
] {
    if at == data.len() {
        return Result::Ok(Option::None)
    }
    if data[at] != 60 {
        let mut end = at;
        while end < data.len() && data[end] != 60 {
            end += 1;
        }
        if end == data.len() && !final_input {
            if end - at > limits.max_token_bytes {
                return Result::Err(
                    error(ErrorKind::Limit, offset + at, "XML text token exceeds limit"),
                )
            }
            return Result::Ok(Option::None)
        }
        if end - at > limits.max_token_bytes {
            return Result::Err(error(ErrorKind::Limit, offset + at, "XML text token exceeds limit"))
        }
        return Result::Ok(
            Option::Some((RawToken::Text(slice_text(data, at, end, offset)?), end - at)),
        )
    }
    if at + 1 >= data.len() {
        return Result::Ok(Option::None)
    }
    if data[at + 1] == 33 {
        if data.len() - at < 4 {
            return Result::Ok(Option::None)
        }
        if begins(data, at, "<!--") {
            let end = find_pattern(data, at + 4, "-->");
            if let Some(end) = end {
                if end + 3 - at > limits.max_token_bytes {
                    return Result::Err(
                        error(ErrorKind::Limit, offset + at, "XML comment exceeds limit"),
                    )
                }
                return Result::Ok(
                    Option::Some(
                        (RawToken::Comment(slice_text(data, at + 4, end, offset)?), end + 3 - at),
                    ),
                )
            }
        } else if begins(data, at, "<![CDATA[") {
            let end = find_pattern(data, at + 9, "]]>");
            if let Some(end) = end {
                if end + 3 - at > limits.max_token_bytes {
                    return Result::Err(
                        error(ErrorKind::Limit, offset + at, "XML CDATA exceeds limit"),
                    )
                }
                return Result::Ok(
                    Option::Some(
                        (RawToken::CData(slice_text(data, at + 9, end, offset)?), end + 3 - at),
                    ),
                )
            }
        } else if data.len() - at < 9 && begins(data, at, "<![") {
            return Result::Ok(Option::None)
        } else {
            return Result::Err(
                error(ErrorKind::Syntax, offset + at, "DTD and markup declarations are disabled"),
            )
        }
        if data.len() - at > limits.max_token_bytes {
            return Result::Err(
                error(ErrorKind::Limit, offset + at, "XML markup token exceeds limit"),
            )
        }
        return Result::Ok(Option::None)
    }
    if data[at + 1] == 63 {
        if let Some(end) = find_pattern(data, at + 2, "?>") {
            if end + 2 - at > limits.max_token_bytes {
                return Result::Err(
                    error(ErrorKind::Limit, offset + at, "XML instruction exceeds limit"),
                )
            }
            let body = slice_text(data, at + 2, end, offset)?;
            let mut split = 0;
            while split < body.byte_len() && !space(body.byte_get(split)) {
                split += 1;
            }
            let target = body.byte_slice(0, split);
            let payload = if target == "xml" {
                let mut start = split;
                let mut end = body.byte_len();
                while start < end && space(body.byte_get(start)) {
                    start += 1;
                }
                while end > start && space(body.byte_get(end - 1)) {
                    end -= 1;
                }
                body.byte_slice(start, end)
            } else {
                let mut start = split;
                while start < body.byte_len() && space(body.byte_get(start)) {
                    start += 1;
                }
                body.byte_slice(start, body.byte_len())
            };
            return Result::Ok(Option::Some((RawToken::Instruction(target, payload), end + 2 - at)))
        }
        if data.len() - at > limits.max_token_bytes {
            return Result::Err(
                error(ErrorKind::Limit, offset + at, "XML instruction exceeds limit"),
            )
        }
        return Result::Ok(Option::None)
    }
    if let Some(end) = tag_end(data, at + 1) {
        if end + 1 - at > limits.max_token_bytes {
            return Result::Err(error(ErrorKind::Limit, offset + at, "XML tag exceeds limit"))
        }
        if data[at + 1] == 47 {
            return Result::Ok(
                Option::Some((RawToken::End(slice_text(data, at + 2, end, offset)?), end + 1 - at)),
            )
        }
        let mut inner_end = end;
        let empty = inner_end > at + 1 && data[inner_end - 1] == 47;
        if empty {
            inner_end -= 1;
        }
        return Result::Ok(
            Option::Some(
                (RawToken::Start(slice_text(data, at + 1, inner_end, offset)?, empty), end + 1 - at),
            ),
        )
    }
    if data.len() - at > limits.max_token_bytes {
        return Result::Err(error(ErrorKind::Limit, offset + at, "XML tag exceeds limit"))
    }
    Result::Ok(Option::None)
}

fn start_element(body: string, scopes: Vec[Vec[Namespace]], limits: Limits, offset: isize) -> Result[
    Element,
    Error,
] {
    let bytes = body.to_bytes();
    let mut cursor = 0;
    while cursor < bytes.len() && !space(bytes[cursor]) {
        cursor += 1;
    }
    if cursor == 0 {
        return Result::Err(error(ErrorKind::Syntax, offset, "missing element name"))
    }
    let raw_name = body.byte_slice(0, cursor);
    let raw_attrs: Vec[RawAttribute] = Vec::new();
    while cursor < bytes.len() {
        if !space(bytes[cursor]) {
            return Result::Err(
                error(ErrorKind::Syntax, offset + cursor, "attributes need whitespace"),
            )
        }
        while cursor < bytes.len() && space(bytes[cursor]) {
            cursor += 1;
        }
        if cursor == bytes.len() {
            break
        }
        let start = cursor;
        while cursor < bytes.len() && !space(bytes[cursor]) && bytes[cursor] != 61 {
            cursor += 1;
        }
        if start == cursor {
            return Result::Err(error(ErrorKind::Syntax, offset + cursor, "missing attribute name"))
        }
        let name = body.byte_slice(start, cursor);
        while cursor < bytes.len() && space(bytes[cursor]) {
            cursor += 1;
        }
        if cursor == bytes.len() || bytes[cursor] != 61 {
            return Result::Err(
                error(ErrorKind::Syntax, offset + cursor, "attribute requires equals"),
            )
        }
        cursor += 1;
        while cursor < bytes.len() && space(bytes[cursor]) {
            cursor += 1;
        }
        if cursor == bytes.len() || (bytes[cursor] != 34 && bytes[cursor] != 39) {
            return Result::Err(
                error(ErrorKind::Syntax, offset + cursor, "attribute requires quotes"),
            )
        }
        let quote = bytes[cursor];
        cursor += 1;
        let value_start = cursor;
        while cursor < bytes.len() && bytes[cursor] != quote {
            cursor += 1;
        }
        if cursor == bytes.len() {
            return Result::Err(
                error(ErrorKind::Syntax, offset + value_start, "unterminated attribute"),
            )
        }
        let value = decode_entities(
            body.byte_slice(value_start, cursor),
            true,
            offset + value_start,
            limits.max_token_bytes,
        )?;
        cursor += 1;
        raw_attrs.push(RawAttribute { name, value });
        if raw_attrs.len() > limits.max_attributes {
            return Result::Err(error(ErrorKind::Limit, offset, "XML attribute count exceeds limit"))
        }
    }
    let declarations: Vec[Namespace] = Vec::new();
    for entry in raw_attrs {
        let prefix = if entry.name == "xmlns" {
            Option::Some("")
        } else if entry.name.starts_with("xmlns:") {
            Option::Some(entry.name.byte_slice(6, entry.name.byte_len()))
        } else {
            Option::None
        };
        if let Some(prefix) = prefix {
            let declaration = Namespace { prefix, uri: entry.value };
            check_namespace(declaration, offset)?;
            for previous in declarations {
                if previous.prefix == prefix {
                    return Result::Err(
                        error(ErrorKind::Namespace, offset, "duplicate namespace declaration"),
                    )
                }
            }
            declarations.push(declaration);
        }
    }
    let name = qualified(raw_name, false, declarations, scopes, offset)?;
    let attributes: Vec[Attribute] = Vec::new();
    for entry in raw_attrs {
        if entry.name == "xmlns" || entry.name.starts_with("xmlns:") {
            continue
        }
        let name = qualified(entry.name, true, declarations, scopes, offset)?;
        for previous in attributes {
            if previous.name.uri == name.uri && previous.name.local == name.local {
                return Result::Err(
                    error(ErrorKind::Namespace, offset, "duplicate expanded attribute"),
                )
            }
        }
        attributes.push(Attribute { name, value: entry.value });
    }
    Result::Ok(Element { name, attributes, namespaces: declarations })
}

fn plain(value: string, offset: isize, limit: isize) -> Result[string, Error] {
    let bytes = value.to_bytes();
    let output: Vec[u8] = Vec::new();
    let mut cursor = 0;
    while cursor < bytes.len() {
        let (character, width) = utf8::decode_first(bytes.as_slice().sub(cursor, bytes.len())).map_err(
            |_| error(ErrorKind::Utf8, offset + cursor, "invalid UTF-8"),
        )?;
        if !xml_character(character) {
            return Result::Err(error(ErrorKind::Syntax, offset + cursor, "forbidden XML character"))
        }
        if character == '\r' {
            if cursor + 1 < bytes.len() && bytes[cursor + 1] == 10 {
                cursor += 1;
            }
            append_text(output, "\n", limit, offset + cursor)?;
        } else {
            append_text(output, character.to_string(), limit, offset + cursor)?;
        }
        cursor += width;
    }
    Result::Ok(string_from_utf8(output).1)
}

fn charge(current: isize, size: isize, limits: Limits, offset: isize) -> Result[isize, Error] {
    if size > limits.max_decoded_bytes - current {
        return Result::Err(error(ErrorKind::Limit, offset, "XML decoded output exceeds limit"))
    }
    Result::Ok(current + size)
}

fn apply_raw(raw: RawToken, state: ReaderState, limits: Limits, offset: isize) -> Result[
    (Vec[Token], ReaderState),
    Error,
] {
    let tokens: Vec[Token] = Vec::new();
    match raw {
        RawToken::Start(body, empty) => {
            if state.root_done {
                return Result::Err(error(ErrorKind::Syntax, offset, "multiple XML root elements"))
            }
            if state.open.len() >= limits.max_depth {
                return Result::Err(error(ErrorKind::Limit, offset, "XML depth limit exceeded"))
            }
            let element = start_element(body, state.scopes, limits, offset)?;
            for attribute in element.attributes {
                state.decoded = charge(state.decoded, attribute.value.byte_len(), limits, offset)?;
            }
            for namespace in element.namespaces {
                state.decoded = charge(state.decoded, namespace.uri.byte_len(), limits, offset)?;
            }
            state.root_seen = true;
            state.open.push(element.name);
            state.scopes.push(element.namespaces.copy());
            tokens.push(Token::Start(element));
            if empty {
                tokens.push(Token::End(state.open.pop().unwrap_or(element.name)));
                let _ = state.scopes.pop();
                if state.open.len() == 0 {
                    state.root_done = true;
                }
            }
        },
        RawToken::End(body) => {
            if state.open.len() == 0 {
                return Result::Err(error(ErrorKind::Syntax, offset, "unexpected XML end tag"))
            }
            let mut end = body.byte_len();
            while end > 0 && space(body.byte_get(end - 1)) {
                end -= 1;
            }
            let raw_name = body.byte_slice(0, end);
            let name = qualified(raw_name, false, Vec::new(), state.scopes, offset)?;
            let expected = state.open[state.open.len() - 1];
            if name != expected {
                return Result::Err(error(ErrorKind::Syntax, offset, "mismatched XML end tag"))
            }
            let _ = state.open.pop();
            let _ = state.scopes.pop();
            if state.open.len() == 0 {
                state.root_done = true;
            }
            tokens.push(Token::End(name));
        },
        RawToken::Text(raw) => {
            if state.open.len() == 0 {
                for value in raw.to_bytes() {
                    if !space(value) {
                        return Result::Err(
                            error(ErrorKind::Syntax, offset, "text outside XML root"),
                        )
                    }
                }
                return Result::Ok((tokens, state))
            }
            if raw.find("]]>").is_some() {
                return Result::Err(error(ErrorKind::Syntax, offset, "CDATA terminator in text"))
            }
            let value = decode_entities(raw, false, offset, limits.max_token_bytes)?;
            if value != "" {
                state.decoded = charge(state.decoded, value.byte_len(), limits, offset)?;
                tokens.push(Token::Text(value));
            }
        },
        RawToken::Comment(raw) => {
            if raw.find("--").is_some() || raw.ends_with("-") {
                return Result::Err(error(ErrorKind::Syntax, offset, "invalid XML comment"))
            }
            let value = plain(raw, offset, limits.max_token_bytes)?;
            state.decoded = charge(state.decoded, value.byte_len(), limits, offset)?;
            tokens.push(Token::Comment(value));
        },
        RawToken::CData(raw) => {
            if state.open.len() == 0 {
                return Result::Err(error(ErrorKind::Syntax, offset, "CDATA outside XML root"))
            }
            let value = plain(raw, offset, limits.max_token_bytes)?;
            state.decoded = charge(state.decoded, value.byte_len(), limits, offset)?;
            tokens.push(Token::CData(value));
        },
        RawToken::Instruction(target, raw) => {
            if !ncname(target) {
                return Result::Err(
                    error(ErrorKind::Syntax, offset, "invalid processing instruction target"),
                )
            }
            if target.to_ascii_lowercase() == "xml"
                && (target != "xml" || state.root_seen || state.tokens != 0
                    || offset != state.declaration_offset) {
                return Result::Err(error(ErrorKind::Syntax, offset, "XML declaration is misplaced"))
            }
            if target == "xml" {
                declaration(raw, offset)?;
            }
            let value = plain(raw, offset, limits.max_token_bytes)?;
            state.decoded = charge(state.decoded, value.byte_len(), limits, offset)?;
            tokens.push(Token::Instruction(target, value));
        },
    }
    if tokens.len() > limits.max_tokens - state.tokens {
        return Result::Err(error(ErrorKind::Limit, offset, "XML token count exceeds limit"))
    }
    state.tokens += tokens.len();
    Result::Ok((tokens, state))
}

impl Reader {
    pub fn new(limits: Limits) -> Result[Reader, Error] {
        limits.validate()?;
        Result::Ok(Reader { limits, state: Ref::new(initial_reader_state()) })
    }

    pub fn pending_bytes(self: Reader) -> isize {
        self.state.get().pending.len()
    }

    pub fn feed(self: Reader, input: Slice[u8]) -> Result[Vec[Token], Error] {
        let state = self.state.get();
        if state.ended || state.failed {
            return Result::Err(error(ErrorKind::State, state.offset, "XML reader is closed"))
        }
        if input.len() > self.limits.max_input_bytes - state.received
            || input.len() > self.limits.max_pending_bytes - state.pending.len() {
            state.failed = true;
            self.state.set(state);
            return Result::Err(
                error(ErrorKind::Limit, state.offset, "XML input or pending limit exceeded"),
            )
        }
        state.pending.extend(input.to_vec());
        state.received += input.len();
        self.state.set(state);
        self.run(false)
    }

    fn run(self: Reader, final_input: bool) -> Result[Vec[Token], Error] {
        let mut state = self.state.get();
        let output: Vec[Token] = Vec::new();
        let mut cursor = 0;
        if state.offset == 0 && state.pending.len() > 0 && state.pending[0] == 239 {
            if state.pending.len() < 3 && !final_input {
                return Result::Ok(output)
            }
            if state.pending.len() >= 3 && state.pending[1] == 187 && state.pending[2] == 191 {
                cursor = 3;
                state.declaration_offset = 3;
            }
        }
        while cursor < state.pending.len() {
            let next = next_raw(state.pending, cursor, state.offset, self.limits, final_input);
            match next {
                Result::Err(problem) => {
                    state.failed = true;
                    self.state.set(state);
                    return Result::Err(problem)
                },
                Result::Ok(Option::None) => break,
                Result::Ok(Option::Some((raw, consumed))) => {
                    match apply_raw(raw, state, self.limits, state.offset + cursor) {
                        Result::Err(problem) => {
                            state.failed = true;
                            self.state.set(state);
                            return Result::Err(problem)
                        },
                        Result::Ok((tokens, updated)) => {
                            state = updated;
                            output.extend(tokens);
                        },
                    }
                    cursor += consumed;
                },
            }
        }
        state.pending = state.pending.slice(cursor, state.pending.len()).to_vec();
        state.offset += cursor;
        self.state.set(state);
        Result::Ok(output)
    }

    pub fn finish(self: Reader) -> Result[Vec[Token], Error] {
        let state = self.state.get();
        if state.ended || state.failed {
            return Result::Err(error(ErrorKind::State, state.offset, "XML reader is closed"))
        }
        let output = self.run(true)?;
        let state = self.state.get();
        if state.pending.len() != 0 || !state.root_seen || state.open.len() != 0 {
            state.failed = true;
            self.state.set(state);
            return Result::Err(error(ErrorKind::Syntax, state.offset, "incomplete XML document"))
        }
        state.ended = true;
        self.state.set(state);
        Result::Ok(output)
    }
}

pub fn read_all(input: Slice[u8], limits: Limits) -> Result[Vec[Token], Error] {
    let reader = Reader::new(limits)?;
    let tokens: Vec[Token] = Vec::new();
    let mut cursor = 0;
    while cursor < input.len() {
        let pending = reader.pending_bytes();
        let available = limits.max_pending_bytes - pending;
        if available == 0 {
            return Result::Err(
                error(ErrorKind::Limit, cursor - pending, "XML pending limit exceeded"),
            )
        }
        let remaining = input.len() - cursor;
        let step = if remaining < available {
            remaining
        } else {
            available
        };
        tokens.extend(reader.feed(input.sub(cursor, cursor + step))?);
        cursor += step;
    }
    tokens.extend(reader.finish()?);
    Result::Ok(tokens)
}
