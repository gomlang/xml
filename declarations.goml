package xml;

fn declaration(value: string, offset: isize) -> Result[(), Error] {
    let mut at = 0;
    let mut stage = 0;
    while at < value.byte_len() {
        let before = at;
        while at < value.byte_len() && space(value.byte_get(at)) {
            at += 1;
        }
        if at == value.byte_len() {
            break
        }
        if stage != 0 && at == before {
            return Result::Err(
                error(ErrorKind::Syntax, offset + at, "XML declaration fields require whitespace"),
            )
        }
        let start = at;
        while at < value.byte_len() && value.byte_get(at) >= b'a' && value.byte_get(at) <= b'z' {
            at += 1;
        }
        let name = value.byte_slice(start, at);
        while at < value.byte_len() && space(value.byte_get(at)) {
            at += 1;
        }
        if at == value.byte_len() || value.byte_get(at) != b'=' {
            return Result::Err(
                error(ErrorKind::Syntax, offset + at, "invalid XML declaration assignment"),
            )
        }
        at += 1;
        while at < value.byte_len() && space(value.byte_get(at)) {
            at += 1;
        }
        if at == value.byte_len() || (value.byte_get(at) != b'\'' && value.byte_get(at) != b'"') {
            return Result::Err(
                error(ErrorKind::Syntax, offset + at, "XML declaration values must be quoted"),
            )
        }
        let quote = value.byte_get(at);
        at += 1;
        let begin = at;
        while at < value.byte_len() && value.byte_get(at) != quote {
            at += 1;
        }
        if at == value.byte_len() {
            return Result::Err(
                error(ErrorKind::Syntax, offset + at, "unterminated XML declaration value"),
            )
        }
        let content = value.byte_slice(begin, at);
        at += 1;
        if name == "version" && stage == 0 {
            if !content.starts_with("1.") || content.byte_len() < 3 {
                return Result::Err(error(ErrorKind::Syntax, offset + begin, "invalid XML version"))
            }
            for index in 2..content.byte_len() {
                if content.byte_get(index) < b'0' || content.byte_get(index) > b'9' {
                    return Result::Err(
                        error(ErrorKind::Syntax, offset + begin, "invalid XML version"),
                    )
                }
            }
            stage = 1;
        } else if name == "encoding" && stage == 1 {
            if content.to_ascii_lowercase() != "utf-8" {
                return Result::Err(
                    error(ErrorKind::Syntax, offset + begin, "only UTF-8 XML encoding is supported"),
                )
            }
            stage = 2;
        } else if name == "standalone" && (stage == 1 || stage == 2) {
            if content != "yes" && content != "no" {
                return Result::Err(
                    error(ErrorKind::Syntax, offset + begin, "invalid XML standalone value"),
                )
            }
            stage = 3;
        } else {
            return Result::Err(
                error(
                    ErrorKind::Syntax,
                    offset + start,
                    "unknown, repeated or misplaced XML declaration field",
                ),
            )
        }
    }
    if stage == 0 {
        return Result::Err(error(ErrorKind::Syntax, offset, "XML declaration requires version"))
    }
    Result::Ok(())
}
