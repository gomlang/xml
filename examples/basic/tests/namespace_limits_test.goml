package tests;

use ecosystem::xml;
use std::testing;

#[test]
fn downstream_writer_counts_namespace_declarations_as_attributes() -> () {
    let limits = xml::Limits { max_attributes: 0, ..xml::Limits::standard() };
    let writer = testing::expect_ok(xml::Writer::new(limits), "writer");
    let element = xml::Element {
        name: xml::QName { prefix: "p", local: "root", uri: "urn:example" },
        attributes: Vec::new(),
        namespaces: Vec::from_array([xml::Namespace { prefix: "p", uri: "urn:example" }]),
    };
    testing::assert_eq(
        testing::expect_err(writer.write(xml::Token::Start(element)), "namespace budget").kind,
        xml::ErrorKind::Limit,
    );
}
