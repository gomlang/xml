package tests;

use ecosystem::xml;
use std::testing;

fn instruction_tokens(source: string, width: isize) -> Result[Vec[xml::Token], xml::Error] {
    let reader = xml::Reader::new(xml::Limits::standard())?;
    let input = source.to_bytes();
    let output = Vec::new();
    let mut cursor = 0;
    while cursor < input.len() {
        let end = if width < input.len() - cursor {
            cursor + width
        } else {
            input.len()
        };
        output.extend(reader.feed(input.slice(cursor, end))?);
        cursor = end;
    }
    output.extend(reader.finish()?);
    Result::Ok(output)
}

#[test]
fn processing_instructions_preserve_content_after_xml_separator_whitespace() -> () {
    // XML Infoset 2.4 excludes only the target and immediately following XML S.
    // These expected payloads also agree with Expat's ProcessingInstructionHandler.
    for (instruction, expected) in Vec::from_array(
        [
            ("<?task value   ?>", "value   "),
            ("<?task \u00a0value\u00a0?>", "\u00a0value\u00a0"),
            ("<?task\t\tvalue\t?>", "value\t"),
            ("<?task \r\nvalue\r\n?>", "value\n"),
            ("<?task \u2003 ?>", "\u2003 "),
            ("<?task a&amp;b ?>", "a&amp;b "),
            ("<?task?>", ""),
            ("<?task \t\r\n?>", ""),
        ],
    ) {
        let source = instruction + "<r/>";
        for width in 1..source.byte_len() + 1 {
            let tokens = testing::expect_ok(instruction_tokens(source, width), "read instruction");
            match tokens[0] {
                xml::Token::Instruction(target, value) => {
                    testing::assert_eq(target, "task");
                    testing::assert_eq(value, expected);
                },
                _ => testing::fail("expected instruction token"),
            }
            let written = testing::expect_ok(
                xml::write_all(tokens, xml::Limits::standard()),
                "write instruction",
            );
            testing::assert(
                testing::expect_ok(instruction_tokens(written, width), "reread instruction")
                    == tokens,
            );
        }
    }
}

#[test]
fn processing_instructions_do_not_trim_invalid_xml_characters() -> () {
    for content in Vec::from_array(["\u000bvalue", "value\u000b", "\u000c", "\u0000"]) {
        let source = "<?task " + content + "?><r/>";
        for width in Vec::from_array([1, source.byte_len()]) {
            let problem = testing::expect_err(
                instruction_tokens(source, width),
                "invalid instruction character",
            );
            testing::assert_eq(problem.kind, xml::ErrorKind::Syntax);
        }
    }
}

#[test]
fn processing_instruction_content_whitespace_counts_toward_decoded_limit() -> () {
    let source = "<?task x  ?><r/>".to_bytes();
    let mut limits = xml::Limits::standard();
    limits.max_decoded_bytes = 3;
    testing::assert_ok(xml::read_all(source.as_slice(), limits));
    limits.max_decoded_bytes = 2;
    let problem = testing::expect_err(xml::read_all(source.as_slice(), limits), "decoded limit");
    testing::assert_eq(problem.kind, xml::ErrorKind::Limit);
}

#[test]
fn processing_instruction_targets_cannot_contain_namespace_colons() -> () {
    // Namespaces in XML 1.0 section 7 requires PI targets to be NCNames.
    // Expat's namespace-aware mode rejects these even when the prefix is declared.
    for source in Vec::from_array(
        ["<?p:task data?><r/>", "<r xmlns:p='urn:p'><?p:task data?></r>", "<r/><?xml:task?>"],
    ) {
        for width in 1..source.byte_len() + 1 {
            testing::assert_eq(
                testing::expect_err(instruction_tokens(source, width), "colon in PI target").kind,
                xml::ErrorKind::Syntax,
            );
        }
    }
}

#[test]
fn writer_rejects_processing_instruction_targets_with_colons() -> () {
    for target in Vec::from_array(["p:task", "xml:task", ":task", "task:", "p:q:task"]) {
        let writer = testing::expect_ok(xml::Writer::new(xml::Limits::standard()), "writer");
        testing::assert_eq(
            testing::expect_err(
                writer.write(xml::Token::Instruction(target, "data")),
                "colon in PI target",
            ).kind,
            xml::ErrorKind::Syntax,
        );
    }
}

#[test]
fn unprefixed_processing_instruction_targets_preserve_unicode_and_extended_xml_names() -> () {
    for target in Vec::from_array(["task", "xml-stylesheet", "XML-task", "_task.2", "任务"]) {
        let source = "<?" + target + " data?><r/>";
        for width in Vec::from_array([1, source.byte_len()]) {
            let tokens = testing::expect_ok(instruction_tokens(source, width), "valid PI target");
            match tokens[0] {
                xml::Token::Instruction(actual, _) => testing::assert_eq(actual, target),
                _ => testing::fail("expected instruction"),
            }
            let wire = testing::expect_ok(
                xml::write_all(tokens, xml::Limits::standard()),
                "write valid PI target",
            );
            testing::assert(testing::expect_ok(instruction_tokens(wire, width), "reread") == tokens);
        }
    }
}
