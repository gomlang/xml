package tests;

use consumer::xml as app;
use ecosystem::xml;
use std::testing;

#[test]
fn versioned_xml_stream_and_serde() -> () {
    app::exercise();
    let tokens = testing::expect_ok(
        xml::read_all(
            "<root xmlns=\"urn:x\"><child/></root>".to_bytes().as_slice(),
            xml::Limits::standard(),
        ),
        "namespaced XML",
    );
    testing::assert_eq(tokens.len(), 4);
    testing::assert_ok(xml::write_all(tokens, xml::Limits::standard()));
}
